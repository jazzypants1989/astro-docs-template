---
import { type CollectionEntry, getCollection, render } from "astro:content"
import Layout from "../../layouts/Docs.astro"
import DocLayout from "../../layouts/Doc.astro"

export async function getStaticPaths() {
  const docs = await getCollection("docs")
  return docs.map((doc) => ({
    params: { slug: doc.id },
    props: doc,
  }))
}

type Props = CollectionEntry<"docs">

const doc = Astro.props

const { data, filePath } = doc

const image = data.image || "/logo.svg"

const { Content } = await render(doc)
---

<Layout title={data.title} description={data.description} image={image}>
  <DocLayout {...data} filePath={filePath}>
    <Content />
  </DocLayout>
</Layout>
