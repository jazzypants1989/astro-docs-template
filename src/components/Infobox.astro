---
export interface Props {
	warning?: boolean;
	hint?: boolean;
}

const { warning, hint } = Astro.props;
---

{
	warning ? (
		<div
			class="bg-red-100/80 border border-red-400 text-red-800 px-4 py-3 rounded-xl relative infobox"
			role="alert"
		>
			<strong class="font-bold">Warning!</strong>
			<span class="block sm:inline">
				<slot />
			</span>
		</div>
	) : null
}
{
	hint ? (
		<div
			class="bg-blue-100/80 border border-blue-400 text-blue-900 px-4 py-3 rounded-xl relative infobox"
			role="alert"
		>
			<strong class="font-bold">Pro Tip!</strong>
			<span class="block sm:inline">
				<slot />
			</span>
		</div>
	) : null
}
{
	!warning && !hint ? (
		<div
			class="bg-yellow-100/80 border border-yellow-400 text-yellow-800 px-4 py-3 rounded-xl relative infobox"
			role="alert"
		>
			<strong class="font-bold">Note:</strong>
			<span class="block sm:inline">
				<slot />
			</span>
		</div>
	) : null
}

<style>
	/* Slotted links come from the parent, so they need :global to be styled here */
	.infobox :global(a) {
		color: #1a202c;
		text-decoration: underline;
	}
</style>
