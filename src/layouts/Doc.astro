---
import type { CollectionEntry } from "astro:content"
import Edit from "../components/edit/Edit.astro"

type Props = CollectionEntry<"docs">["data"] & { filePath?: string }

const { title, description, pubDate, updatedDate, image, video, filePath } =
  Astro.props

// filePath is the path to the source file, relative to the project root
// (e.g. "src/content/docs/a-section/mdx-file.mdx"), which is what the edit links need
---

<article
  class="max-w-2xl mx-0 md:mx-auto p-4 space-y-4 flex flex-col items-center justify-center text-center"
>
  <h1 class="text-4xl font-bold">{title}</h1>
  {
    video ? (
      <iframe
        src={video}
        title={title}
        allowfullscreen
        class="aspect-video rounded-2xl w-full"
      />
    ) : image ? (
      <img
        src={image}
        alt={description}
        class="aspect-video max-h-96 w-full rounded-2xl"
      />
    ) : null
  }
  <p>{description}</p>
  <p>Published: {pubDate.toLocaleDateString()}</p>
  <p>Last Updated: {updatedDate?.toLocaleDateString()}</p>
  <div
    class="bg-primary-NOTSODARK/80 p-3 m-2 rounded-2xl flex flex-col items-center justify-center space-y-2 md:space-y-4 text-start"
  >
    <slot />
  </div>
  <Edit file={filePath} />
</article>
